# Copie para .env e preencha localmente. Nunca envie sua chave pelo chat.
GEMINI_API_KEY=
GEMINI_MODEL=
PORT=3000
# Opcional: aumenta os limites de uso do OpenDota.
OPENDOTA_API_KEY=

# Ambiente local (chave salva pelo iniciador Windows continua funcionando).
DOTA_ENV=local
HOST=127.0.0.1
LOG_LEVEL=warn
REQUEST_TIMEOUT_MS=120000
EXTERNAL_TIMEOUT_MS=25000
CACHE_TTL_MS=300000
# Em produção: DOTA_ENV=production, HOST=0.0.0.0 e HTTPS obrigatório.
APP_ORIGIN=
APP_ACCESS_PASSWORD=
# GOOGLE_API_KEY também é aceita como alternativa a GEMINI_API_KEY.
